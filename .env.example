# Base URL of the local inverter web interface, without /api/v1 or credentials.
PLENTICORE_URL=http://plenticore.example
# Plant owner password from the local web interface; no installer code needed.
PLENTICORE_PASSWORD=replace-locally
PLENTICORE_TIMEOUT=20
PLENTICORE_VERIFY_SSL=true
# Set true to disable settings changes. Updates always preview by default.
PLENTICORE_READ_ONLY=true
